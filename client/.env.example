# URL of the backend API. Vite bakes this into the build at BUILD time,
# so make sure it's set correctly in your hosting provider's build
# environment (not just locally) before deploying.
#
# Local development:
VITE_API_URL=http://localhost:5000/api
#
# Production example:
# VITE_API_URL=https://your-api-domain.com/api
