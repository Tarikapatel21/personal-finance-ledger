# ==========================================
# SERVER
# ==========================================

# Render provides PORT automatically.
# Local development uses 5000.
PORT=5000


# ==========================================
# CORS
# ==========================================

# Production example:
#
# CORS_ORIGIN=https://your-frontend.onrender.com
#
# Multiple origins can be separated by commas.
#
# Leave empty for local development.

CORS_ORIGIN=


# ==========================================
# INITIAL DATABASE SETUP
# ==========================================

# These values are used ONLY when the
# SQLite database has zero months.

# Example:
INITIAL_MONTH=2027-01

# Amount must be stored in paise.
#
# ₹21,000 = 2,100,000 paise
#
INITIAL_OPENING_BALANCE_PAISE=2100000